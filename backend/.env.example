# ==============================================================================
# MARKETMIND AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="MarketMind AI"
VERSION=1.0.0
DEBUG=true

# Server Networking
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Security & JWT Tokens
SECRET_KEY=dev_marketmind_super_secret_jwt_hmac_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Data Providers Configuration
MARKET_DATA_PROVIDER=yfinance  # options: yfinance, mock
NEWS_PROVIDER=mock            # options: mock, newsapi, polygon
FUNDAMENTALS_PROVIDER=mock    # options: mock, sec_edgar, fmp

# AI & LLM Integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Distributed Caching (Redis) - In-memory fallback is active if unavailable
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false

# Vector Database (Qdrant) - In-memory fallback is active if unavailable
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=marketmind_sec_10k

# PostgreSQL / TimescaleDB (Configured for Phase 2 Database Implementation)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketmind_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
