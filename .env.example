# ==============================================================================
# MARKETMIND AI — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / TimescaleDB
POSTGRES_USER=marketmind_admin
POSTGRES_PASSWORD=marketmind_secret
POSTGRES_DB=marketmind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://marketmind_admin:marketmind_secret@localhost:5432/marketmind_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Financial Data Providers & Routing (Phase 6)
DEFAULT_MARKET_PROVIDER=auto
MARKET_DATA_PROVIDER=auto
INDIA_MARKET_PROVIDER=indian
US_MARKET_PROVIDER=yfinance

# Financial Data APIs (Optional: fallback to high-fidelity synthetic demo generator if empty)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Indian Licensed Market Data / Broker API Keys (Optional / Future Phase 6.2)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP=

# Observability & Tracing (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market-feed
NEXT_PUBLIC_DEMO_MODE=true
